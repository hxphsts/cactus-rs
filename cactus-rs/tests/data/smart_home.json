{
  "source": "https://github.com/cactus-compute/needle/blob/94df999/needle/environments/smart_home.py",
  "license": "Apache-2.0",
  "system": "Map each explicit supported home action to exactly one declared call; never duplicate an action. Do not guess missing targets or values. Unsupported, invalid, ambiguous, and negated requests return no call.",
  "tools": [
    {
      "name": "control_lights",
      "description": "Turn lights on or off in a room, dim them to a brightness percentage, or set their color. A color request means action on. Never use this for blinds, fans, or any other device.",
      "parameters": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string",
            "enum": [
              "kitchen",
              "living_room",
              "bedroom",
              "study"
            ],
            "description": "The room to control."
          },
          "action": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "dim"
            ],
            "description": "on, off, or dim."
          },
          "brightness_percent": {
            "type": "integer",
            "description": "Brightness from 0 to 100. A dim request with a number must carry it in this same call.",
            "minimum": 0,
            "maximum": 100
          },
          "color": {
            "type": "string",
            "enum": [
              "warm white",
              "cool white",
              "red",
              "green",
              "blue"
            ],
            "description": "The light color; include only when the user names one."
          }
        },
        "required": [
          "room",
          "action"
        ]
      }
    },
    {
      "name": "set_thermostat",
      "description": "Set the home thermostat to a target temperature in degrees Celsius. This never controls fans, lights, or any other device.",
      "parameters": {
        "type": "object",
        "properties": {
          "temperature": {
            "type": "integer",
            "description": "Target temperature in degrees Celsius.",
            "minimum": 10,
            "maximum": 30
          }
        },
        "required": [
          "temperature"
        ]
      }
    },
    {
      "name": "control_fan",
      "description": "Turn a room fan on or off, optionally at a stated speed. This never changes the thermostat.",
      "parameters": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string",
            "enum": [
              "living_room",
              "bedroom",
              "study"
            ],
            "description": "The room whose fan to control."
          },
          "action": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ],
            "description": "on or off."
          },
          "speed": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "description": "Fan speed; include only when stated."
          }
        },
        "required": [
          "room",
          "action"
        ]
      }
    },
    {
      "name": "control_blinds",
      "description": "Open or close the window blinds in one stated room. Never pick the room yourself. Never use this for lights or the vacuum.",
      "parameters": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string",
            "enum": [
              "kitchen",
              "living_room",
              "bedroom",
              "study"
            ],
            "description": "The room whose blinds to move."
          },
          "action": {
            "type": "string",
            "enum": [
              "open",
              "close"
            ],
            "description": "open or close."
          }
        },
        "required": [
          "room",
          "action"
        ]
      }
    },
    {
      "name": "start_robot_vacuum",
      "description": "Start or stop the robot vacuum, or send it back to its dock to charge.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "stop",
              "dock"
            ],
            "description": "start, stop, or dock."
          },
          "room": {
            "type": "string",
            "enum": [
              "kitchen",
              "living_room",
              "bedroom"
            ],
            "description": "The room to clean; include only when starting a run in a stated room."
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ],
  "cases": [
    {
      "query": "turn on the kitchen lights",
      "calls": [
        {
          "name": "control_lights",
          "arguments": {
            "room": "kitchen",
            "action": "on"
          }
        }
      ],
      "category": "positive"
    },
    {
